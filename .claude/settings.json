{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Glob",
      "Grep",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git remote -v)",
      "PowerShell(python --version)",
      "PowerShell(python -m pytest:*)",
      "PowerShell(python -m json.tool:*)",
      "PowerShell(uv run:*)",
      "PowerShell(uv pip list:*)",
      "PowerShell(ruff check:*)",
      "PowerShell(ruff format --check:*)",
      "PowerShell(mypy:*)",
      "PowerShell(npm run lint:*)",
      "PowerShell(npm run typecheck:*)",
      "PowerShell(npm run test:*)",
      "PowerShell(npx tsc --noEmit:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(ollama list)",
      "PowerShell(ollama ps)"
    ],
    "ask": [
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(pip install:*)",
      "PowerShell(uv add:*)",
      "PowerShell(npm install:*)",
      "PowerShell(ollama pull:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets.*)",
      "Read(**/credentials*)",
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/*.lock)",
      "Read(**/package-lock.json)",
      "Read(**/uv.lock)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_commands.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_check.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_devlog_reminder.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
