# Copie para .env e preencha localmente.
# NUNCA versionar o .env. NUNCA colocar valores reais neste arquivo.

# === PostgreSQL academico IESB ===
# Host/porta/database reais NAO ficam aqui: este arquivo e versionado.
# Copie para .env e preencha com os dados da conexao do DBeaver.
PGHOST=
PGPORT=5432
PGDATABASE=
PGSCHEMA=public
PGSSLMODE=prefer

# Credencial unica (ADR-0002: a conta nao tem CREATEROLE, entao nao ha papel
# dedicado; a trava e aplicada na sessao pelo pool de conexoes).
PGUSER=
PGPASSWORD=

# Travas de sessao aplicadas em TODA conexao nova. Nao desligar.
PG_SESSION_READ_ONLY=true
PG_STATEMENT_TIMEOUT=60s
PG_IDLE_TX_TIMEOUT=60s

# Os guarda-corpos do Analista IA (allowlist de tabelas, teto de linhas, timeout) ficam no codigo
# (api/analista/, api/config.py), nao em variaveis de ambiente.

# === LLM (Analista IA) ===
# Provedor: AWS Bedrock (ADR-0021), ainda nao implementado; modelo a confirmar. Credenciais da
# AWS NUNCA entram neste exemplo nem no repositorio: vem do perfil SSO da AWS CLI (ADR-0022).
LLM_PROVIDER=bedrock
LLM_TIMEOUT_SECONDS=120

# === API ===
# A API NAO le este arquivo nem precisa de segredo: consulta so o DuckDB local (ADR-0003).
# Exporte as variaveis abaixo no ambiente se quiser mudar os padroes de api/config.py.
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
API_QUERY_TIMEOUT_SECONDS=10
ANALYTICS_DUCKDB_PATH=data/analytics/censo_2024.duckdb
LOG_LEVEL=INFO
