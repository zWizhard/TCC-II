# === Dados (grandes / brutos — nao versionar) ===
*.csv
*.parquet
*.xlsx
*.dbf
*.shp
*.shx
*.zip
*.7z

# **/ para pegar tambem docs/data/raw/, onde os CSVs do Censo estao hoje.
# SEM barra final de proposito: git nao consegue re-incluir um arquivo que esta
# dentro de um diretorio excluido, e a excecao das evidencias abaixo nao funcionaria.
**/data/raw/*
**/data/interim/
**/data/processed/
**/data/external/

# GeoJSON pequeno de referencia pode ser versionado explicitamente com `git add -f`
*.geojson
!data/reference/**/*.geojson

# Excecao: evidencias das auditorias do banco (KB, nao MB) sustentam a metodologia
# do TCC e sao versionadas. Precisa vir DEPOIS de `*.csv`: vence a ultima regra que casa.
!**/data/raw/diagnostics/
**/data/raw/diagnostics/*
!**/data/raw/diagnostics/*.csv

# === Notebooks ===
.ipynb_checkpoints/

# === Logs e temporarios ===
*.log
logs/
tmp/
.cache/

