# Normalizacao de fim de linha. O trabalho e feito no Windows (CRLF) e o repositorio
# vai para o GitHub: sem isto, o diff enche de ruido de CRLF/LF.
* text=auto eol=lf

# Scripts que precisam de LF mesmo no checkout do Windows.
*.sh   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf

# Arquivos que o git nunca deve tentar normalizar.
*.csv     -text
*.parquet binary
*.xlsx    binary
*.png     binary
*.jpg     binary
*.pdf     binary
*.geojson -text

# Nao contam como codigo nas estatisticas de linguagem do GitHub.
docs/data/raw/** linguist-generated=true
